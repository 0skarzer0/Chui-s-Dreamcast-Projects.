<!DOCTYPE fenixdoc SYSTEM "fenixdoc.dtd">

<function name="IS_XPM">
<retval/>
<param name="fichero" type="STRING"> Nombre de un fichero </param>
<abstract> Devuelve 1 si el fichero es una imagen en formato XPM </abstract>
<description>
    <p>
	Esta función comprueba el formate de una imagen en disco y
	devuelve 1 si la imagen está en formato XPM o 0 en caso contrario.
    </p>
</description>

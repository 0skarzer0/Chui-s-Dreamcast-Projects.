FXE_TEXT =	"FENIX LOADER"
FXE_COMP =	"CHUI"
FXE_ICON =	../fxi/res/gp32icon.bmp


ARM_COMP = 	arm-thumb-elf


CC = $(ARM_COMP)-gcc
AR = $(ARM_COMP)-ar
AS = $(ARM_COMP)-as
LD = $(ARM_COMP)-gcc
OBJCOPY = 	$(ARM_COMP)-objcopy
B2FXEC =	b2fxec
GPLINK =	gplink

EXEC_NAME =	fsl

MAPFILE	=	$(EXEC_NAME).map
TARGET_ELF =	$(EXEC_NAME).elf
TARGET_BIN =	$(EXEC_NAME).gxb
TARGET_FXE =	$(EXEC_NAME).fxe
LDSCRIPT =	../fxi/gp32/lnkscript
USER_INIT =	../fxi/gp32/user_init.o


.SFILES	=	../fxi/gp32/crt0.s \

.CFILES	=	../fxi/gp32/gpstart.c \
		src/fsl.c \
		src/stretch.c \
		src/video.c \
		src/process.c \
		src/audio.c \
		src/parse.c \
		src/error.c \
		src/bin.c \
		src/run.c \
		src/SFont/SFont.c \
		src/ML_Lib/ML_Attribute.c \
		src/ML_Lib/ML_Comment.c \
		src/ML_Lib/ML_common_func.c \
		src/ML_Lib/ML_COM_Sim.c \
		src/ML_Lib/ML_Document.c \
		src/ML_Lib/ML_Element.c \
		src/ML_Lib/ML_leng_process.c \
		src/ML_Lib/ML_Node.c \
		src/ML_Lib/ML_Process.c \
		src/ML_Lib/ML_Text.c \
		../fxi/src/main.c \
		../fxi/src/dcbr.c \
		../fxi/src/instance.c \
		../fxi/src/strings.c \
		../fxi/src/i_main.c \
		../fxi/src/i_debug.c \
		../fxi/src/i_func.c \
		../fxi/src/i_saveload.c \
		../fxi/src/g_main.c \
		../fxi/src/g_maps.c \
		../fxi/src/g_blit_fixed.c \
		../fxi/src/g_texts.c \
		../fxi/src/g_pal.c \
		../fxi/src/g_draw.c \
		../fxi/src/g_systexts.c \
		../fxi/src/g_console.c \
		../fxi/src/g_scroll.c \
		../fxi/src/g_flic.c \
		../fxi/src/g_mode7.c \
		../fxi/src/img_png.c \
		../fxi/src/img_pcx.c \
		../fxi/src/sound.c \
		../fxi/src/pathfind.c \
		../fxi/src/fnc_exports.c \
		../fxi/src/g_conversion.c \
		../fxi/src/g_font.c \
		../fxi/src/g_fpg.c \
		../fxi/src/g_blendop.c \
		../fxi/src/g_profiler.c \
		../common/files.c \
		../common/xctype.c \
		../common/dirs.c \


.OFILES	=	$(.SFILES:.s=.o) $(.CFILES:.c=.o)


all: $(TARGET_FXE)

DEFS= -DGP32 -DTARGET_GP32 -DTARGET_linux -DFSL -DUSE_FIXED_POINT \
		-DFILE_SEPARATOR=\"\\\\\" \
		-DDATA_PREFIX=\"gp:\\\\gpmm\\\\fenix\\\\\" \


DEFS+= -DNO_CONSOLE -DNO_PROFILER 

OPTFLAGS=-O3 -mtune=arm920 -march=armv4t -marm -mno-thumb-interwork -msoft-float -ffast-math -nostdlib -Wall -ffreestanding -fno-builtin -fno-exceptions -mstructure-size-boundary=8 -fomit-frame-pointer -fstrict-aliasing

CFLAGS =	-I../fxi/gp32/include -Isrc/ -Isrc/ML_Lib -Isrc/SFont -I../include -I../fxi/inc -I../fxi/src -I/usr/$(ARM_COMP)/include/SDL $(OPTFLAGS) $(DEFS)


LDFLAGS	=	-T$(LDSCRIPT) $(USER_INIT) -nostartfiles \
		-lgpos -lgpsound -lgpmem -lgpgraphic -lgpfont \
		-lSDL_image -lSDL_flic -lSDL_mixer -lSDL \
		-lpng -ljpeg -lz -lm -lgpstdlib -lgpstdio -Wno-thumb \

clean:
	rm -f $(.OFILES) $(TARGET_FXE) $(TARGET_BIN) $(TARGET_ELF)

$(TARGET_FXE):	$(TARGET_BIN)
	$(B2FXEC) -t $(FXE_TEXT) -a $(FXE_COMP) -b $(FXE_ICON) $< $@


$(TARGET_BIN): $(TARGET_ELF)
	$(OBJCOPY) -O binary $< $@


$(TARGET_ELF): $(.OFILES) $(DEPENDFILE) $(TARGET)
	$(LD) -o $@ $(.OFILES) $(TARGET) $(LDFLAGS)

send: $(TARGET_FXE)
	$(GPLINK) -x put $(TARGET_FXE) /GPMM


run: $(TARGET_BIN)
	$(GPLINK) run $(TARGET_BIN)

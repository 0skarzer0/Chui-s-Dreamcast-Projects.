TARGET = ../bin/fsl

KOS_CFLAGS+= -I$(KOS_BASE)/addons/include/ -I$(KOS_BASE)/addons/include/SDL  -I../fxi/dc/include -I../fxi/inc -I../include -I../fxi/src -Isrc -Isrc/SFont -Isrc/ML_Lib -DDREAMCAST -DTARGET_DREAMCAST -DTARGET_DC -DTARGET_LINUX -DTARGET_linux -DLINUX -DFSL -DNO_FSL_MAIN -DDATA_PREFIX="/cd/exec/" -DFILE_SEPARATOR="/" -DNO_CONSOLE -DNO_PROFILER -DNO_USE_TV_FILTER

KOS_CFLAGS+=-DVERTICAL_SCROLL
KOS_CFLAGS+=-DNO_DESC

KOS_LDFLAGS+= -Wl,--no-check-sections

all: $(TARGET).bin

include $(KOS_BASE)/Makefile.rules

.CFILES	=	../fxi/dc/dcmain.c \
		src/fsl.c \
		src/stretch.c \
		src/video.c \
		src/process.c \
		src/audio.c \
		src/parse.c \
		src/error.c \
		src/bin.c \
		src/run.c \
		src/SFont/SFont.c \
		src/ML_Lib/ML_Attribute.c \
		src/ML_Lib/ML_Comment.c \
		src/ML_Lib/ML_common_func.c \
		src/ML_Lib/ML_COM_Sim.c \
		src/ML_Lib/ML_Document.c \
		src/ML_Lib/ML_Element.c \
		src/ML_Lib/ML_leng_process.c \
		src/ML_Lib/ML_Node.c \
		src/ML_Lib/ML_Process.c \
		src/ML_Lib/ML_Text.c \
		../fxi/src/main.c \
		../fxi/src/dcbr.c \
		../fxi/src/instance.c \
		../fxi/src/strings.c \
		../fxi/src/i_main.c \
		../fxi/src/i_debug.c \
		../fxi/src/i_func.c \
		../fxi/src/i_saveload.c \
		../fxi/src/g_main.c \
		../fxi/src/g_maps.c \
		../fxi/src/g_blit.c \
		../fxi/src/g_texts.c \
		../fxi/src/g_pal.c \
		../fxi/src/g_draw.c \
		../fxi/src/g_systexts.c \
		../fxi/src/g_console.c \
		../fxi/src/g_scroll.c \
		../fxi/src/g_flic.c \
		../fxi/src/g_mode7.c \
		../fxi/src/img_png.c \
		../fxi/src/img_pcx.c \
		../fxi/src/sound.c \
		../fxi/src/pathfind.c \
		../fxi/src/fnc_exports.c \
		../fxi/src/g_conversion.c \
		../fxi/src/g_font.c \
		../fxi/src/g_fpg.c \
		../fxi/src/g_blendop.c \
		../fxi/src/g_profiler.c \
		../fxi/src/f_joystick.c \
		../fxi/src/f_cd.c \
		../fxi/src/fpl.c \
		../fxi/src/fbm.c \
		../fxi/src/fgc.c \
		../fxi/src/f_sort.c \
		../fxi/src/i_copy.c \
		../fxi/src/f_bgload.c \
		../common/files.c \
		../common/xctype.c \
		../common/dirs.c \
		../common/regex.c \


#OBJS =		$(.CFILES:.c=.o) romdisk.o
OBJS =		$(.CFILES:.c=.o)


clean:
	rm -f $(OBJS) $(TARGET).elf $(TARGET).bin romdisk.o romdisk.img ../bin/example.iso

$(TARGET).elf: $(OBJS)
	$(KOS_CC) $(KOS_CFLAGS) $(KOS_LDFLAGS) -o $(TARGET).elf $(KOS_START) \
	$(OBJS) -lpng_128 -lz_123 -lSDL_mixer_126 -lSDL_image_124 -lSDL_129 $(OBJEXTRA) -lm -lstdc++ $(KOS_LIBS) 

romdisk.o: romdisk.img
	$(KOS_BASE)/utils/bin2o/bin2o romdisk.img romdisk romdisk.o

romdisk.img:
	$(KOS_GENROMFS) -f romdisk.img -d ../bin/data -v

$(TARGET).bin: $(TARGET).elf
	$(KOS_OBJCOPY) -R .stack -O binary $(TARGET).elf $(TARGET).bin

../bin/example.iso: ../bin/exec
	mkisofs -joliet-long -l -o ../bin/example.iso -graft-points /exec/=../bin/exec/

run: $(TARGET).elf ../bin/example.iso
	$(KOS_LOADER) $(TARGET).elf -i ../bin/example.iso

